---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

const { post, allPosts } = Astro.props;

// Lookup related articles
const relatedPosts = (post.data.relatedArticles || [])
  .map(id => allPosts.find(p => p.id === id || (p as any).slug === id))
  .filter(Boolean) as CollectionEntry<'posts'>[];

// Lookup Prev / Next
const prevPost = post.data.prevId ? allPosts.find(p => p.id === post.data.prevId || (p as any).slug === post.data.prevId) : null;
const nextPost = post.data.nextId ? allPosts.find(p => p.id === post.data.nextId || (p as any).slug === post.data.nextId) : null;
const postSlug = post.id || (post as any).slug;

---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
  type="article"
  canonicalPath={`/article/${postSlug}`}
  category={post.data.category}
  datePublished={post.data.date}
  dateModified={post.data.date}
  faqs={post.data.faqs}
>
  <main class="main-content">
    <div class="content-container">
      <!-- Article Main Column -->
      <article class="content-area">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="面包屑导航">
          <a href="/"><i class="fa-solid fa-house" style="font-size: 11px; margin-right: 4px;"></i>首页</a>
          <span class="separator">/</span>
          <a href={`/?category=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
          <span class="separator">/</span>
          <span class="current">{post.data.title}</span>
        </nav>

        <!-- Article Main Card -->
        <div class="card article-card-main">
          <!-- Article Header -->
          <header class="article-header">
            <div class="article-category">
              <span class={`tag-pill ${post.data.categoryClass}`}>
                <i class={post.data.categoryIcon}></i> {post.data.category}
              </span>
            </div>
            <h1 class="article-title">{post.data.title}</h1>
            <div class="article-meta">
              <span class="article-meta-item">
                <i class="fa-regular fa-user"></i> 大肥鱼
              </span>
              <span class="article-meta-item">
                <i class="fa-regular fa-calendar"></i> {post.data.date}
              </span>
              <span class="article-meta-item">
                <i class="fa-regular fa-clock"></i> {post.data.readingTime}
              </span>
              <span class="article-meta-item">
                <i class="fa-regular fa-eye"></i> {post.data.views}
              </span>
            </div>
          </header>

          <!-- Article Lead & Markdown Content -->
          <div class="article-content" id="articleContent">
            {post.data.lead && <p class="article-lead">{post.data.lead}</p>}
            <slot />

            <!-- FAQ Section (Generated directly from Frontmatter SSOT) -->
            {post.data.faqs && post.data.faqs.length > 0 && (
              <div class="article-faq-wrapper">
                <h2 id="faq">
                  <i class="fa-solid fa-circle-question" style="color: var(--accent-primary); margin-right: 8px;"></i>常见问题解答 (FAQ)
                </h2>
                <div class="faq-container">
                  {post.data.faqs.map((faq, index) => (
                    <div class="faq-item">
                      <div class="faq-question">
                        <span class="faq-q-badge">Q{index + 1}：</span> {faq.q}
                      </div>
                      <div class="faq-answer">
                        {faq.a}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Related Articles & High-Density Internal Links Grid -->
            {relatedPosts && relatedPosts.length > 0 && (
              <div class="related-articles-section">
                <h2 id="related-articles">
                  <i class="fa-solid fa-link" style="color: var(--accent-primary); margin-right: 8px;"></i>延伸阅读与精选内链推荐
                </h2>
                <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 12px;">
                  欢迎继续探索本站关联精选专栏，体系化掌握网络加速、流媒体解锁与 AI 生产力核心技术：
                </p>
                <div class="related-articles-grid">
                  {relatedPosts.map(rel => (
                    <a href={`/article/${rel.id || (rel as any).slug}`} class="related-article-card">
                      <div class="related-card-top">
                        <span class={`tag-pill-sm ${rel.data.categoryClass}`}>
                          <i class={rel.data.categoryIcon}></i> {rel.data.category}
                        </span>
                        <span style="font-size: 12px; color: var(--text-muted);">
                          <i class="fa-regular fa-clock"></i> {rel.data.readingTime}
                        </span>
                      </div>
                      <div class="related-card-title">{rel.data.title}</div>
                      <p class="related-card-excerpt">{rel.data.lead}</p>
                      <div class="related-card-footer">
                        <span><i class="fa-regular fa-calendar"></i> {rel.data.date}</span>
                        <span class="related-read-more">阅读全文 <i class="fa-solid fa-arrow-right"></i></span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Prev / Next Post Navigation -->
        <nav class="post-navigation">
          {prevPost ? (
            <a href={`/article/${prevPost.id || (prevPost as any).slug}`} class="nav-card prev">
              <span class="nav-label"><i class="fa-solid fa-arrow-left"></i> 上一篇</span>
              <span class="nav-title">{prevPost.data.title}</span>
            </a>
          ) : <div class="nav-card-placeholder"></div>}

          {nextPost ? (
            <a href={`/article/${nextPost.id || (nextPost as any).slug}`} class="nav-card next">
              <span class="nav-label">下一篇 <i class="fa-solid fa-arrow-right"></i></span>
              <span class="nav-title">{nextPost.data.title}</span>
            </a>
          ) : <div class="nav-card-placeholder"></div>}
        </nav>
      </article>

      <!-- Sticky Table of Contents (文章目录导航) -->
      <aside class="toc-container" id="articleSidebarRight">
        <div class="toc-card">
          <div class="toc-title">
            <i class="fa-solid fa-list-ul"></i>
            <span>文章目录</span>
          </div>
          <nav class="toc-nav" id="tocNav">
            <!-- Populated dynamically on client side -->
          </nav>
        </div>
      </aside>
    </div>
  </main>

  <!-- Client-side TOC Generation & Active Highlighting -->
  <script is:inline>
    function buildTOC() {
      const content = document.getElementById('articleContent');
      const toc = document.getElementById('tocNav');
      if (!content || !toc) return;

      const headings = content.querySelectorAll('h2, h3');
      if (!headings.length) {
        toc.innerHTML = '<span style="color: var(--text-muted); font-size: 12.5px; padding: 6px 8px; display: block;">本文暂无各级标题</span>';
        return;
      }

      toc.innerHTML = '';
      headings.forEach((heading, index) => {
        let id = heading.id;
        if (!id) {
          id = 'heading-' + index;
          heading.id = id;
        }

        const isH3 = heading.tagName.toLowerCase() === 'h3';
        const link = document.createElement('a');
        link.href = '#' + id;
        link.className = 'toc-link ' + (isH3 ? 'toc-h3' : 'toc-h2');
        link.textContent = heading.textContent.replace(/^#\s*/, '').trim();

        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetEl = document.getElementById(id);
          if (targetEl) {
            const topPos = targetEl.getBoundingClientRect().top + window.pageYOffset - 80;
            window.scrollTo({ top: topPos, behavior: 'smooth' });
            history.pushState(null, null, '#' + id);
          }
        });

        toc.appendChild(link);
      });

      // Active Scroll Spy
      const links = toc.querySelectorAll('.toc-link');
      if (!links.length) return;

      function onScroll() {
        const scrollPos = window.scrollY + 120;
        let currentHeading = null;

        headings.forEach(h => {
          if (h.offsetTop <= scrollPos) {
            currentHeading = h;
          }
        });

        links.forEach(l => l.classList.remove('active'));
        if (currentHeading) {
          const activeLink = toc.querySelector('a[href="#' + currentHeading.id + '"]');
          if (activeLink) activeLink.classList.add('active');
        } else if (links[0]) {
          links[0].classList.add('active');
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // Reading Progress Bar (Fixed Top)
    const pBar = document.getElementById('readingProgress') || document.querySelector('.reading-progress');
    if (pBar) {
      function updateReadingProgress() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
        const scrollHeight = (document.documentElement.scrollHeight || document.body.scrollHeight) - window.innerHeight;
        if (scrollHeight > 0) {
          const scrolled = Math.min(100, Math.max(0, (scrollTop / scrollHeight) * 100));
          pBar.style.width = scrolled + '%';
        }
      }
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      window.addEventListener('resize', updateReadingProgress, { passive: true });
      updateReadingProgress();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', buildTOC);
    } else {
      buildTOC();
    }
  </script>
</BaseLayout>
