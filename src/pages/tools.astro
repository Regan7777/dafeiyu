---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="实用工具箱与常用导航"
  description="精心筛选并整理的优质科学上网客户端、AI生产力助手、网络诊断测速与实用订阅工具，开箱即用，提升日常数字生活效率。"
  keywords={['科学上网客户端', 'Clash Verge Rev', 'Sing-box', 'v2rayN', 'ChatGPT', 'Claude', 'Speedtest', 'Subconverter']}
  type="website"
  canonicalPath="/tools"
>
  <main class="main-content">
      <div class="content-container" style="max-width: 1080px;">
        <section class="content-area">
          <!-- Tools Hero Header -->
          <div class="hero-banner">
            <h1 class="hero-title">
              <i class="fa-solid fa-toolbox" style="color: var(--accent-primary);"></i>
              实用工具箱 & 常用导航
            </h1>
            <p class="hero-subtitle">
              精心筛选并整理的优质科学上网客户端、AI 生产力助手、网络诊断测速与实用订阅工具，开箱即用，提升日常数字生活效率。
            </p>
          </div>

          <!-- Tools Filter Tabs -->
          <div class="tools-filter-tabs" id="toolTabs">
            <button class="tool-tab-btn active" data-tab="all">全部工具 (12)</button>
            <button class="tool-tab-btn" data-tab="proxy">网络代理客户端</button>
            <button class="tool-tab-btn" data-tab="ai">AI 智能助手</button>
            <button class="tool-tab-btn" data-tab="network">网络测速与诊断</button>
            <button class="tool-tab-btn" data-tab="media">订阅转换与流媒体</button>
          </div>

                    <!-- Tools Grid -->
          <div class="tools-grid" id="toolsGrid">
            <!-- Tool 1: Clash Verge Rev -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/clash-verge.png" alt="Clash Verge Rev"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Clash Verge Rev</h3>
                  <span class="tool-category-badge">代理客户端</span>
                </div>
              </div>
              <p class="tool-desc">
                基于 Tauri 框架打造的现代 Clash Meta/Mihomo 内核客户端，轻巧美观，支持智能分流与规则扩展配置。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Win</span>
                  <span class="platform-badge">Mac</span>
                  <span class="platform-badge">Linux</span>
                </div>
                <a href="https://github.com/clash-verge-rev/clash-verge-rev/releases" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  官网下载 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 2: Sing-box -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/sing-box.png" alt="Sing-box"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Sing-box</h3>
                  <span class="tool-category-badge">代理平台</span>
                </div>
              </div>
              <p class="tool-desc">
                下一代通用代理网络平台，支持 Shadowsocks、VLESS、Hysteria2、TUIC 等全部主流新协议，内存占用极低。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">全平台</span>
                </div>
                <a href="https://sing-box.sagernet.org" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  官方文档 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 3: Shadowrocket -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/shadowrocket.png" alt="Shadowrocket"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Shadowrocket</h3>
                  <span class="tool-category-badge">iOS 客户端</span>
                </div>
              </div>
              <p class="tool-desc">
                iOS / iPadOS 平台最经典的轻量级规则分流代理工具（小火箭），配置灵活，支持多种订阅一键导入。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">iOS</span>
                </div>
                <a href="https://apps.apple.com/app/shadowrocket/id932747118" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  App Store <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 4: v2rayN -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/v2rayn.png" alt="v2rayN"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">v2rayN</h3>
                  <span class="tool-category-badge">Windows 客户端</span>
                </div>
              </div>
              <p class="tool-desc">
                Windows 平台老牌经典代理 GUI 客户端，全面兼容 Xray 内核与 Sing-box 内核，支持全自动真连接批量测速。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Windows</span>
                </div>
                <a href="https://github.com/2dust/v2rayN/releases" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  GitHub <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 5: Clash Mi -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/clash-mi.png" alt="Clash Mi"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Clash Mi</h3>
                  <span class="tool-category-badge">跨端轻量</span>
                </div>
              </div>
              <p class="tool-desc">
                基于 Flutter 框架打造的跨平台轻量代理利器，内置 Mihomo 满血内核与精致 Web 仪表盘，极低待机内存消耗。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">全平台</span>
                </div>
                <a href="https://clashmi.app" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  官网下载 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 6: Nextin (星拓) -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/nextin.png" alt="Nextin 星拓"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Nextin (星拓)</h3>
                  <span class="tool-category-badge">Apple 全生态</span>
                </div>
              </div>
              <p class="tool-desc">
                专为 Apple 全生态打造的免费高性能客户端，App Store 免费获取，原生支持 VLESS/Reality 与 Apple TV 客厅串流。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Apple全系</span>
                </div>
                <a href="https://nextin.mom" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  官方主页 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 7: Karing -->
            <div class="tool-card" data-category="proxy">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/karing.png" alt="Karing"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Karing</h3>
                  <span class="tool-category-badge">多协议聚合</span>
                </div>
              </div>
              <p class="tool-desc">
                基于 Flutter 与优化版 sing-box 核心开发的开源代理客户端，通吃全格式订阅，支持局域网与 WebDAV 一键跨端同步。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">全平台</span>
                </div>
                <a href="https://karing.app" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  官网下载 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 8: DeepSeek -->
            <div class="tool-card" data-category="ai">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/deepseek.png" alt="DeepSeek"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">DeepSeek</h3>
                  <span class="tool-category-badge">推理大模型</span>
                </div>
              </div>
              <p class="tool-desc">
                拥有顶尖数学与代码逻辑推理能力的开源大模型，V3 通用版与 R1 满血深度思考模型，提供极高性价比 API 接口。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web / App</span>
                </div>
                <a href="https://chat.deepseek.com" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  立即访问 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 9: ChatGPT -->
            <div class="tool-card" data-category="ai">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/chatgpt.png" alt="ChatGPT"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">ChatGPT</h3>
                  <span class="tool-category-badge">对话式 AI</span>
                </div>
              </div>
              <p class="tool-desc">
                全球最主流的通用人工智能对话助手，支持 GPT-4o 多模态交互、高级实时语音、Canvas 代码协作及 DALL-E 绘图。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web / App</span>
                </div>
                <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  立即访问 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 10: Claude -->
            <div class="tool-card" data-category="ai">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/claude.png" alt="Claude"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Claude</h3>
                  <span class="tool-category-badge">代码与长文</span>
                </div>
              </div>
              <p class="tool-desc">
                Anthropic 出品的新一代 AI 助手，以超长上下文理解能力、极低幻觉率与无与伦比的代码编写及技术文档处理见长。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web / App</span>
                </div>
                <a href="https://claude.ai" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  立即访问 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 11: Speedtest by Ookla -->
            <div class="tool-card" data-category="network">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/speedtest.png" alt="Speedtest"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Speedtest by Ookla</h3>
                  <span class="tool-category-badge">带宽测速</span>
                </div>
              </div>
              <p class="tool-desc">
                全球最权威的互联网连接测速服务平台，精准测试代理节点的下行带宽、上行速度、网络延迟与 Jitter 抖动。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web / App</span>
                </div>
                <a href="https://www.speedtest.net" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  开始测速 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 12: IP.sb / IPinfo -->
            <div class="tool-card" data-category="network">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/ipinfo.png" alt="IPinfo"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">IP.sb / IPInfo</h3>
                  <span class="tool-category-badge">网络诊断</span>
                </div>
              </div>
              <p class="tool-desc">
                精确查询当前代理节点的出站公网 IP、地理位置、所属 ASN 运营商、原生住宅/机房属性及欺诈分评分。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web</span>
                </div>
                <a href="https://ip.sb" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  检测 IP <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 13: Subconverter -->
            <div class="tool-card" data-category="media">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/subconverter.png" alt="Subconverter"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">Subconverter 订阅转换</h3>
                  <span class="tool-category-badge">格式转换</span>
                </div>
              </div>
              <p class="tool-desc">
                将机场的通用订阅链接无损转换为 Clash、Sing-box、Surge、Shadowrocket 等专属格式，支持注入自定义分流规则。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">Web</span>
                </div>
                <a href="https://sub.xeton.dev" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  转换工具 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 14: 流媒体全区解锁检测 -->
            <div class="tool-card" data-category="media">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/streaming.png" alt="流媒体解锁检测"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">流媒体全区解锁检测</h3>
                  <span class="tool-category-badge">流媒体</span>
                </div>
              </div>
              <p class="tool-desc">
                快速检测代理节点对 Netflix、Disney+、YouTube Premium、TikTok、OpenAI 等关键服务的原生解锁状态。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">脚本 / Web</span>
                </div>
                <a href="https://github.com/oneclickvirt/securityCheck" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  查看脚本 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- Tool 15: 沉浸式双语翻译 -->
            <div class="tool-card" data-category="media">
              <div class="tool-card-top">
                <div class="tool-icon"><img src="images/immersive-translate.png" alt="沉浸式双语翻译"></div>
                <div class="tool-header-text">
                  <h3 class="tool-name">沉浸式双语翻译</h3>
                  <span class="tool-category-badge">效率扩展</span>
                </div>
              </div>
              <p class="tool-desc">
                智能双语对照排版翻译浏览器扩展，支持接入各大顶尖大模型 API，流畅阅读外文技术文档与社交媒体。
              </p>
              <div class="tool-card-footer">
                <div class="tool-platforms">
                  <span class="platform-badge">浏览器扩展</span>
                </div>
                <a href="https://immersivetranslate.com" target="_blank" rel="noopener noreferrer" class="tool-btn">
                  安装扩展 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>
          </div>
      </section>
      </div>
    </main>

  <script is:inline>
    // Tab filtering for tools
    const toolTabs = document.querySelectorAll('.tool-tab-btn');
    const toolCards = document.querySelectorAll('.tool-card');

    toolTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        toolTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const cat = tab.getAttribute('data-tab');
        toolCards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
