---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts')).sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Category configs
const categories = [
  { name: '科学上网', icon: 'fa-solid fa-paper-plane', tagClass: 'tag-proxy' },
  { name: '机场推荐', icon: 'fa-solid fa-plane-departure', tagClass: 'tag-airport' },
  { name: '海外流媒体', icon: 'fa-solid fa-tv', tagClass: 'tag-media' },
  { name: 'AI工具与实战', icon: 'fa-solid fa-robot', tagClass: 'tag-ai' },
  { name: '实用工具', icon: 'fa-solid fa-screwdriver-wrench', tagClass: 'tag-tools' },
];

// Helper to normalize category
function normCat(cat: string) {
  if (cat === '流媒体' || cat === '海外流媒体') return '海外流媒体';
  if (cat === 'AI使用' || cat === 'AI工具与实战' || cat === 'AI实战' || cat === 'AI工具') return 'AI工具与实战';
  return cat;
}

// Calculate tag counts
const tagCounts: Record<string, number> = {};
allPosts.forEach(post => {
  (post.data.keywords || []).forEach((k: string) => {
    const tag = k.trim();
    if (tag) {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    }
  });
});

const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 25);
---

<BaseLayout
  title="标签聚合与全站索引"
  description="按标签快速检索全站关于 Clash、Sing-box、机场推荐、海外流媒体解锁、DeepSeek 与效率神器的核心技术干货。"
  keywords={['文章标签', 'Clash', 'Sing-box', '机场推荐', '海外流媒体解锁', 'DeepSeek', 'Chrome扩展']}
  type="website"
  canonicalPath="/tags"
>
  <main class="main-content">
    <div class="content-container" style="max-width: 960px;">
      <section class="content-area">
        <!-- 1. Hero Header Banner -->
        <div class="hero-banner">
          <h1 class="hero-title">
            <i class="fa-solid fa-tags" style="color: var(--accent-primary);"></i>
            全站标签与分类索引
          </h1>
          <p class="hero-subtitle">
            收录全站 {allPosts.length} 篇硬核干货与 25+ 个核心技术标签。点击任意标签或分类即可快速聚合查看相关主题文章，精准定位所需内容。
          </p>
        </div>

        <!-- 2. Interactive Tag Wall Card -->
        <div class="card tags-cloud-card">
          <!-- Search Inside Tags -->
          <div class="tags-search-wrapper">
            <div class="tags-search-box-inner">
              <i class="fa-solid fa-magnifying-glass search-icon"></i>
              <input type="text" class="tags-search-input" id="tagSearchInput" placeholder="快速过滤标签（例如：Clash, Netflix, DeepSeek...）" autocomplete="off" />
            </div>
          </div>

          <!-- Tags Cloud Pills -->
          <div class="tags-cloud-container" id="tagsCloudContainer">
            <button class="tag-wall-pill active" data-tag="all">
              <i class="fa-solid fa-asterisk"></i> 全部文章
              <span class="tag-count">{allPosts.length}</span>
            </button>
            {categories.map(cat => {
              const count = allPosts.filter(p => normCat(p.data.category) === cat.name).length;
              return (
                <button class="tag-wall-pill" data-tag={cat.name}>
                  <i class={cat.icon}></i> {cat.name}
                  <span class="tag-count">{count}</span>
                </button>
              );
            })}
            {topTags.map(([tag, count]) => (
              <button class="tag-wall-pill" data-tag={tag}>
                <i class="fa-solid fa-hashtag"></i> {tag}
                <span class="tag-count">{count}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Filter Status Bar -->
        <div class="active-filter-bar" id="tagFilterBar" style="display: none; margin-bottom: 24px;">
          <div class="filter-info">
            <i class="fa-solid fa-filter"></i>
            <span>当前筛选标签：<strong id="activeTagName">全部</strong></span>
            <span class="filter-count">（匹配 <span id="tagMatchCount">{allPosts.length}</span> 篇文章）</span>
          </div>
          <button class="filter-clear-btn" id="tagFilterClearBtn">
            <i class="fa-solid fa-xmark"></i> 清除筛选
          </button>
        </div>

        <!-- 3. Grouped Tag Sections -->
        <div class="tag-sections-list" id="tagSectionsList">
          {categories.map(cat => {
            const catPosts = allPosts.filter(p => normCat(p.data.category) === cat.name);
            return (
              <div class="card tag-section-card" data-section-cat={cat.name}>
                <div class="tag-section-header">
                  <div class="tag-section-title-wrap">
                    <div class="tag-section-icon"><i class={cat.icon}></i></div>
                    <h2 class="tag-section-title">{cat.name}</h2>
                    <span class="tag-section-badge">{catPosts.length} 篇文章</span>
                  </div>
                  <a href={`/?category=${encodeURIComponent(cat.name)}`} class="tag-section-link">在首页查看 →</a>
                </div>
                <div class="tag-articles-group">
                  {catPosts.map(post => (
                    <div class="tag-article-item" data-category={normCat(post.data.category)} data-tags={(post.data.keywords || []).join(', ')}>
                      <div class="tag-article-top">
                        <span class={`tag-pill ${cat.tagClass}`}>{cat.name}</span>
                        <span class="tag-article-date"><i class="fa-regular fa-calendar"></i> {post.data.date}</span>
                      </div>
                      <a href={`/article/${post.id}`} class="tag-article-title-link">{post.data.title}</a>
                      <p class="tag-article-desc">{post.data.description || post.data.lead}</p>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    const tagPills = document.querySelectorAll('.tag-wall-pill');
    const articleItems = document.querySelectorAll('.tag-article-item');
    const sectionCards = document.querySelectorAll('.tag-section-card');
    const filterBar = document.getElementById('tagFilterBar');
    const activeTagName = document.getElementById('activeTagName');
    const matchCountEl = document.getElementById('tagMatchCount');
    const clearBtn = document.getElementById('tagFilterClearBtn');
    const searchInput = document.getElementById('tagSearchInput');

    function applyFilter(selected) {
      if (!selected || selected === 'all') {
        if (filterBar) filterBar.style.display = 'none';
        tagPills.forEach(p => p.classList.toggle('active', p.getAttribute('data-tag') === 'all'));
        articleItems.forEach(item => { item.style.display = 'block'; });
        sectionCards.forEach(sec => { sec.style.display = 'block'; });
        return;
      }

      if (filterBar) filterBar.style.display = 'flex';
      if (activeTagName) activeTagName.textContent = selected;

      tagPills.forEach(p => p.classList.toggle('active', p.getAttribute('data-tag') === selected));

      let matchedTotal = 0;
      sectionCards.forEach(sec => {
        let secMatches = 0;
        const items = sec.querySelectorAll('.tag-article-item');
        items.forEach(item => {
          const cat = item.getAttribute('data-category') || '';
          const tags = item.getAttribute('data-tags') || '';
          if (cat === selected || tags.toLowerCase().includes(selected.toLowerCase())) {
            item.style.display = 'block';
            secMatches++;
            matchedTotal++;
          } else {
            item.style.display = 'none';
          }
        });
        sec.style.display = secMatches > 0 ? 'block' : 'none';
      });

      if (matchCountEl) matchCountEl.textContent = matchedTotal;
    }

    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-tag');
        applyFilter(tag);
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        applyFilter('all');
        if (searchInput) searchInput.value = '';
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim().toLowerCase();
        tagPills.forEach(p => {
          const t = (p.getAttribute('data-tag') || '').toLowerCase();
          if (t === 'all') return;
          p.style.display = (val === '' || t.includes(val)) ? 'inline-flex' : 'none';
        });
      });
    }

    // Check URL params
    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get('tag');
    if (initialTag) {
      applyFilter(initialTag);
    }
  </script>
</BaseLayout>
